def check_market_hours():
    tz = zoneinfo.ZoneInfo("America/New_York")
    now = datetime.datetime.now(tz)
    if now.weekday() >= 5:
        system_state["market_status"] = "CLOSED (Weekend)"
        system_state["market_phase"] = "closed"
        return
    pre_open = now.replace(hour=4, minute=0, second=0, microsecond=0)
    market_open = now.replace(hour=9, minute=30, second=0, microsecond=0)
    market_close = now.replace(hour=16, minute=0, second=0, microsecond=0)
    after_close = now.replace(hour=20, minute=0, second=0, microsecond=0)
    if market_open <= now <= market_close:
        system_state["market_status"] = "OPEN (Live Session)"
        system_state["market_phase"] = "open"
    elif pre_open <= now < market_open:
        system_state["market_status"] = "PRE-MARKET"
        system_state["market_phase"] = "premarket"
    elif market_close < now <= after_close:
        system_state["market_status"] = "AFTER-HOURS"
        system_state["market_phase"] = "afterhours"
    else:
        system_state["market_status"] = "CLOSED (Off-Hours)"
        system_state["market_phase"] = "closed"


