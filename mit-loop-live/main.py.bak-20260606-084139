def calculate_wilders_atr(df, period=14):
    df = df.copy()
    df['prev_close'] = df['close'].shift(1)
    tr1 = df['high'] - df['low']
    tr2 = (df['high'] - df['prev_close']).abs()
    tr3 = (df['low'] - df['prev_close']).abs()
    df['true_range'] = pd.concat([tr1, tr2, tr3], axis=1).max(axis=1)
    return df['true_range'].ewm(alpha=1/period, adjust=False).mean()


def find_daily_pivot_lows(df_d, lookback=60):
    """Return list of recent daily pivot lows. Used to trail the Salmog3 runner."""
    if len(df_d) < lookback:
        return []
    recent = df_d.iloc[-lookback:].copy()
    recent['rolling_min_11'] = recent['low'].rolling(11).min()
    recent['is_pivot_low'] = recent['low'].shift(5) == recent['rolling_min_11']
    pivots = recent['low'].shift(5).where(recent['is_pivot_low']).dropna()
    return sorted(pivots.tolist())


