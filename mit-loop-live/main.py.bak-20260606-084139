def find_next_pivot_above(df_w, body_level):
    """Find next weekly resistance pivot above body_level (for Salmog3 TP1)."""
    if 'is_pivot' not in df_w.columns:
        return None
    pivot_highs = df_w[df_w['is_pivot']]['high']
    above = pivot_highs[pivot_highs > body_level * 1.05]   # at least 5% above entry
    if not above.empty:
        return float(above.max())
    # Fallback: 6-month cycle high
    cycle_high = df_w['high'].iloc[-26:].max()
    if cycle_high > body_level * 1.05:
        return float(cycle_high)
    return None


def run_daily_scan():
