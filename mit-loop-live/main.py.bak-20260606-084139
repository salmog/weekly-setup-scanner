            "live_price": live_px,
            "dist": distance_to_level,
            "status": status,
            "logic": logic_desc,
            "atr_pct": atr_pct,
            "actionable": actionable,
            "ignored": is_ignored,
        })

    discovered_setups.sort(key=lambda x: (x["status"] != "TRIGGER", abs(x["dist"])))
    system_state["pending_setups"] = discovered_setups

