            logic_desc = f"APPROACHING: +{distance_to_level:.2f}% above target"
            actionable = False
        elif 5 < distance_to_level <= WATCHLIST_MAX_PCT:
            status = "WATCH"
            logic_desc = f"WATCHLIST: +{distance_to_level:.2f}% above target"
            actionable = False
        else:
            continue   # too far away to track

        discovered_setups.append({
