            # ============================================================
            setup_active = False
            trigger_level, breakout_vol, weeks_above = 0.0, 0.0, 0
            for i in range(1, len(recent_df)):
                row = recent_df.iloc[i]
                prev_row = recent_df.iloc[i-1]
                current_res = row['swing_body_res']
                if pd.isna(current_res):
                    continue

                if not setup_active:
                    is_liquid = row['close'] >= 5.0 and row['close'] * row['vol_avg'] >= 5_000_000
                    is_breakout = row['close'] > current_res and prev_row['close'] <= current_res
                    is_macro_bull = pd.notna(row['sma30']) and row['close'] > row['sma30']
                    is_zigzag = row['close'] <= row['ema20'] * 1.25
                    is_high_vol = row['volume'] > row['vol_avg'] * 2.5
                    is_aligned = row['ema20'] > row['sma50']
                    is_sloping_up = i >= 4 and row['ema20'] > recent_df.iloc[i-4]['ema20']
