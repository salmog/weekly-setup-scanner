def fetch_tqqq_1m_bars(lookback_minutes=120):
    """Fetch recent 1-min TQQQ bars from Alpaca."""
    try:
        tz = zoneinfo.ZoneInfo("America/New_York")
        end = datetime.datetime.now(tz)
        start = end - datetime.timedelta(minutes=lookback_minutes)
        req = StockBarsRequest(
            symbol_or_symbols=S4_SYMBOL,
            timeframe=TimeFrame(1, TimeFrameUnit.Minute),
            start=start, end=end,
        )
        bars = data_client.get_stock_bars(req)
        if bars.df.empty:
            return None
        df = bars.df.xs(S4_SYMBOL).reset_index()
        df.columns = df.columns.str.lower()
        for col in ['open', 'high', 'low', 'close', 'volume']:
            df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0)
        return df
    except Exception as e:
        log_system_action(f"[TQQQ] Bars fetch failed: {str(e)[:80]}")
        return None


def compute_1m_indicators(df):
    """Compute 1-min indicators for TQQQ regime strategy."""
    df = df.copy()
    df['ema9']  = df['close'].ewm(span=9, adjust=False).mean()
    df['ema20'] = df['close'].ewm(span=20, adjust=False).mean()
    df['tr'] = pd.concat([
        df['high'] - df['low'],
        (df['high'] - df['close'].shift(1)).abs(),
        (df['low'] - df['close'].shift(1)).abs(),
    ], axis=1).max(axis=1)
    df['atr'] = df['tr'].rolling(14, min_periods=5).mean()
    df['vol_avg'] = df['volume'].rolling(20, min_periods=5).mean()
    df['tp'] = (df['high'] + df['low'] + df['close']) / 3
    df['cum_tp_vol'] = (df['tp'] * df['volume']).cumsum()
    df['cum_vol'] = df['volume'].cumsum().replace(0, np.nan)
    df['vwap'] = df['cum_tp_vol'] / df['cum_vol']
    delta = df['close'].diff()
    gain = delta.clip(lower=0).rolling(14, min_periods=5).mean()
    loss = (-delta.clip(upper=0)).rolling(14, min_periods=5).mean()
    rs = gain / loss.replace(0, np.nan)
    df['rsi'] = 100 - (100 / (1 + rs))
    return df


def detect_tqqq_regime():
    """Detect today's regime from ORB. Called at 09:46 ET."""
    tz = zoneinfo.ZoneInfo("America/New_York")
    now = datetime.datetime.now(tz)
    if now.weekday() >= 5:
        return
    df = fetch_tqqq_1m_bars(lookback_minutes=30)
    if df is None or len(df) < 10:
        system_state["s4_regime"] = "CHOPPY"
        log_system_action("[TQQQ] Insufficient ORB data. Defaulting to CHOPPY.")
        return
    orb_high = float(df['high'].max())
    orb_low = float(df['low'].min())
    orb_open = float(df.iloc[0]['open'])
    orb_close = float(df.iloc[-1]['close'])
    orb_range = (orb_high - orb_low) / orb_open if orb_open > 0 else 0
    orb_move = (orb_close - orb_open) / orb_open if orb_open > 0 else 0
    if orb_move > 0.003 and orb_range > 0.005:
        regime = "TREND_UP"
    elif orb_move < -0.003 and orb_range > 0.005:
        regime = "TREND_DOWN"
    else:
        regime = "CHOPPY"
    system_state["s4_regime"] = regime
    system_state["s4_orb_high"] = orb_high
    system_state["s4_orb_low"] = orb_low
    log_system_action(
        f"[TQQQ] Regime: {regime} | ORB: {orb_open:.2f}->{orb_close:.2f} "
        f"({orb_move*100:+.2f}%) range {orb_range*100:.2f}% | H={orb_high:.2f} L={orb_low:.2f}"
    )
    if regime == "TREND_UP":
        _tqqq_enter_trend_hold(orb_close, orb_low)


TQQQ_ACCOUNTS = ["S4_TQQQ_Regime", "S5_TQQQ_Regime_B"]


def _tqqq_enter_trend_hold(entry_price, stop_price):
    """TREND_UP: buy TQQQ at ORB close on all TQQQ accounts."""
    for acct_name in TQQQ_ACCOUNTS:
        client = clients.get(acct_name)
        if not client:
            continue
        try:
            for p in client.get_all_positions():
                if p.symbol == S4_SYMBOL:
                    log_system_action(f"[{acct_name}] Already holding {p.qty}sh -- skipping trend entry.")
                    client = None
                    break
            if not client:
                continue
            account = client.get_account()
            equity = float(account.equity)
            bp = float(account.buying_power)
            shares = int(min(bp, equity) / entry_price)
            if shares < 1:
                continue
            client.submit_order(MarketOrderRequest(
                symbol=S4_SYMBOL, qty=shares, side=OrderSide.BUY, time_in_force=TimeInForce.DAY,
            ))
            log_system_action(
                f"[{acct_name}] TREND HOLD: {shares}x @ ~${entry_price:.2f} | Stop: ORB low ${stop_price:.2f}"
            )
        except Exception as e:
            log_system_action(f"[{acct_name}] Trend entry failed: {str(e)[:80]}")


def run_tqqq_scalp():
    """CHOPPY regime: mean-reversion scalps on all TQQQ accounts. Every 1 min 09:46-14:30 ET."""
    tz = zoneinfo.ZoneInfo("America/New_York")
    now = datetime.datetime.now(tz)
    if now.weekday() >= 5:
        return
    if system_state.get("s4_regime") != "CHOPPY":
        return
    if now.hour > 14 or (now.hour == 14 and now.minute > 30):
        return
    if now.hour < 9 or (now.hour == 9 and now.minute < 46):
        return
    df = fetch_tqqq_1m_bars(lookback_minutes=60)
    if df is None or len(df) < 20:
        return
    df = compute_1m_indicators(df)
    current = df.iloc[-1]
    if pd.isna(current.get('rsi')) or pd.isna(current.get('vwap')) or pd.isna(current.get('atr')):
        return
    if current['atr'] <= 0:
        return
    vwap_dist = (current['close'] - current['vwap']) / current['vwap'] if current['vwap'] > 0 else 0
    is_oversold = current['rsi'] < S4_RSI_OVERSOLD or vwap_dist < -0.015
    is_green = current['close'] > current['open']
    if not (is_oversold and is_green):
        return
    stop = current['close'] - 1.5 * current['atr']
    risk = current['close'] - stop
    if risk <= 0:
        return
    for acct_name in TQQQ_ACCOUNTS:
        client = clients.get(acct_name)
        if not client:
            continue
        try:
            already_in = any(p.symbol == S4_SYMBOL for p in client.get_all_positions())
            if already_in:
                continue
            account = client.get_account()
            equity = float(account.equity)
            shares = int(math.floor((equity * S4_RISK_PCT_SCALP) / risk))
            if shares < 1:
                continue
            client.submit_order(MarketOrderRequest(
                symbol=S4_SYMBOL, qty=shares, side=OrderSide.BUY, time_in_force=TimeInForce.DAY,
            ))
            log_system_action(
                f"[{acct_name}] SCALP: {shares}x @ ${current['close']:.2f} | "
                f"RSI={current['rsi']:.0f} VWAP={vwap_dist*100:.2f}%"
            )
        except Exception as e:
            log_system_action(f"[{acct_name}] Scalp entry failed: {str(e)[:80]}")


def manage_tqqq_position():
    """Position management for all TQQQ accounts: every 1 min during market hours."""
    tz = zoneinfo.ZoneInfo("America/New_York")
    now = datetime.datetime.now(tz)
    if now.weekday() >= 5:
        return
    if now.hour < 9 or (now.hour == 9 and now.minute < 46):
        return
    if now.hour > S4_FORCE_FLAT_HOUR or (now.hour == S4_FORCE_FLAT_HOUR and now.minute >= S4_FORCE_FLAT_MIN):
        return
    regime = system_state.get("s4_regime", "CHOPPY")

    # Fetch bars once, reuse for all accounts
    df_trend = None
    df_scalp = None
    if regime == "TREND_UP":
        df_trend = fetch_tqqq_1m_bars(lookback_minutes=60)
    elif regime == "CHOPPY":
        df_scalp = fetch_tqqq_1m_bars(lookback_minutes=30)

    for acct_name in TQQQ_ACCOUNTS:
        client = clients.get(acct_name)
        if not client:
            continue
        try:
            positions = client.get_all_positions()
        except Exception:
            continue
        tqqq_pos = None
        for p in positions:
            if p.symbol == S4_SYMBOL:
                tqqq_pos = p
                break
        if not tqqq_pos:
            continue
        entry = float(tqqq_pos.avg_entry_price)
        qty = int(float(tqqq_pos.qty))
        current_price = float(tqqq_pos.current_price)
        pnl_pct = (current_price - entry) / entry if entry > 0 else 0
        exit_reason = None
        if regime == "TREND_UP":
            orb_low = system_state.get("s4_orb_low", 0)
            if df_trend is not None and len(df_trend) >= 20:
                df_i = compute_1m_indicators(df_trend)
                ema20 = float(df_i['ema20'].iloc[-1])
                trail_stop = max(orb_low, ema20) if pd.notna(ema20) else orb_low
            else:
                trail_stop = orb_low
            if current_price < trail_stop and trail_stop > 0:
                exit_reason = f"Trend trail stop (${trail_stop:.2f})"
        elif regime == "CHOPPY":
            if pnl_pct > S4_SCALP_TP_PCT:
                exit_reason = f"Scalp TP +{pnl_pct*100:.2f}%"
            elif pnl_pct < -S4_SCALP_CUT_PCT:
                exit_reason = f"Scalp cut {pnl_pct*100:.2f}%"
            elif df_scalp is not None and len(df_scalp) >= 14:
                df_i = compute_1m_indicators(df_scalp)
                rsi = df_i['rsi'].iloc[-1]
                if pd.notna(rsi) and rsi > 60 and pnl_pct > 0:
                    exit_reason = f"RSI bounce complete ({rsi:.0f})"
        if exit_reason:
            try:
                orders = client.get_orders()
                for o in orders:
                    if o.symbol == S4_SYMBOL:
                        client.cancel_order_by_id(o.id)
                client.submit_order(MarketOrderRequest(
                    symbol=S4_SYMBOL, qty=qty, side=OrderSide.SELL, time_in_force=TimeInForce.DAY,
                ))
                log_system_action(
                    f"[{acct_name}] EXIT {qty}sh @ ~${current_price:.2f} | P&L: {pnl_pct*100:+.2f}% | {exit_reason}"
                )
            except Exception as e:
                log_system_action(f"[{acct_name}] Exit failed: {str(e)[:80]}")


def force_flat_tqqq():
    """15:50 ET: force flat TQQQ on all accounts. Never hold overnight."""
    for acct_name in TQQQ_ACCOUNTS:
        try:
            client = clients[acct_name]
            client.close_all_positions(cancel_orders=True)
            log_system_action(f"[{acct_name}] 15:50 ET FORCE FLAT -- no overnight.")
        except Exception as e:
            log_system_action(f"[{acct_name}] Force flat failed: {str(e)[:80]}")
    system_state["s4_regime"] = None


