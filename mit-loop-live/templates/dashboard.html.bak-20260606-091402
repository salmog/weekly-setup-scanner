<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MIT-Loop Pro · Quant Trading Terminal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <script>
        setInterval(async function() {
            if (document.querySelector('.modal.show') || document.activeElement.tagName === 'INPUT') return;
            try {
                const res = await fetch(window.location.href);
                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const main = document.getElementById('app-main');
                const newMain = doc.getElementById('app-main');
                if (main && newMain) main.innerHTML = newMain.innerHTML;
            } catch(e) {}
        }, 30000);

        function validatePanic() {
            document.getElementById('panicConfirmBtn').disabled = document.getElementById('panicInput').value !== 'LIQUIDATE';
        }
        function checkRisk(el, entry, qty, nav) {
            const sl = parseFloat(el.value), w = document.getElementById('rw-'+el.id);
            if (!w||isNaN(sl)) return;
            const r = (entry-sl)*qty, m = nav*0.01;
            w.style.display = r>m?'block':'none';
            if(r>m) w.innerHTML = '<b>Risk $'+r.toFixed(2)+' exceeds 1% NAV ($'+m.toFixed(2)+')</b>';
        }
        function updateTimer() {
            const now = new Date(), est = new Date(now.toLocaleString("en-US",{timeZone:"America/New_York"}));
            const d=est.getDay(),h=est.getHours(),m=est.getMinutes();
            let t=new Date(est),p="";
            if(d>=1&&d<=5&&(h>9||(h===9&&m>=30))&&h<16){t.setHours(16,0,0,0);p="CLOSE ";}
            else{p="OPEN ";if(d===5&&h>=16){t.setDate(t.getDate()+3);t.setHours(9,30,0,0);}else if(d===6){t.setDate(t.getDate()+2);t.setHours(9,30,0,0);}else if(d===0){t.setDate(t.getDate()+1);t.setHours(9,30,0,0);}else if(h>=16){t.setDate(t.getDate()+1);t.setHours(9,30,0,0);}else t.setHours(9,30,0,0);}
            const df=t-est,hh=Math.floor(df/3600000),mm=Math.floor((df%3600000)/60000),ss=Math.floor((df%60000)/1000);
            const el=document.getElementById("mkt-timer");
            if(el)el.innerText=p+hh+"h "+mm+"m "+ss+"s";
        }
        setInterval(updateTimer,1000);window.onload=updateTimer;
    </script>

    <style>
        :root{--bg0:#0a0d14;--bg1:#0f131c;--bg2:#161b27;--bg3:#1c2330;--brd:#232b3a;--brd2:#2e3849;--t0:#f5f7fa;--t1:#c6cad3;--t2:#828a99;--t3:#555c6b;--acc:#4d8eff;--acc2:#00d4ff;--grn:#22c993;--grn-bg:rgba(34,201,147,.12);--red:#ff5b6b;--red-bg:rgba(255,91,107,.12);--yel:#ffba3c;--yel-bg:rgba(255,186,60,.12);--pur:#a878ff;--pur-bg:rgba(168,120,255,.12)}
        *{font-family:'Inter',-apple-system,sans-serif}
        body{background:var(--bg0);color:var(--t1);margin:0;font-size:13px;line-height:1.4}
        .mono{font-family:'JetBrains Mono',monospace;font-variant-numeric:tabular-nums}

        .top-bar{background:var(--bg1);border-bottom:1px solid var(--brd);padding:10px 20px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:100}
        .brand{display:flex;align-items:center;gap:10px}
        .brand-logo{width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,var(--acc),var(--acc2));display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;font-size:14px}
        .brand-name{font-size:14px;font-weight:700;color:var(--t0);letter-spacing:-.3px}
        .brand-sub{font-size:10px;color:var(--t2);text-transform:uppercase;letter-spacing:1px}
        .hdr-actions{display:flex;gap:6px;align-items:center}

        .pill{display:inline-block;padding:2px 8px;border-radius:3px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
        .pill-grn{background:var(--grn-bg);color:var(--grn)}.pill-red{background:var(--red-bg);color:var(--red)}.pill-yel{background:var(--yel-bg);color:var(--yel)}.pill-blu{background:rgba(77,142,255,.12);color:var(--acc)}.pill-gry{background:rgba(120,128,150,.12);color:var(--t2)}.pill-pur{background:var(--pur-bg);color:var(--pur)}
        .mkt-badge{padding:4px 10px;border-radius:4px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
        .mkt-open{background:var(--grn-bg);color:var(--grn);border:1px solid rgba(34,201,147,.3)}
        .mkt-pre{background:var(--yel-bg);color:var(--yel);border:1px solid rgba(255,186,60,.3)}
        .mkt-closed{background:rgba(120,128,150,.12);color:var(--t2);border:1px solid var(--brd)}

        /* Info strip */
        .info-strip{display:flex;gap:1px;background:var(--brd);border-bottom:1px solid var(--brd)}
        .info-cell{background:var(--bg1);padding:10px 16px;flex:1;min-width:0}
        .info-label{font-size:9px;color:var(--t2);text-transform:uppercase;letter-spacing:1px;font-weight:700;margin-bottom:2px}
        .info-val{font-size:15px;font-weight:700;color:var(--t0)}
        .info-sub{font-size:10px;color:var(--t2);margin-top:1px}
        .live-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--grn);animation:pulse 1.5s ease-in-out infinite;vertical-align:middle;margin-right:4px}
        @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

        /* Strategy cards */
        #app-main{padding:14px 18px}
        .strat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:14px}
        @media(max-width:1200px){.strat-grid{grid-template-columns:1fr}}
        .sc{background:var(--bg1);border:1px solid var(--brd);border-radius:8px;overflow:hidden}
        .sc.paused{opacity:.7;border-color:var(--yel)}
        .sc-hdr{background:var(--bg2);border-bottom:1px solid var(--brd);padding:10px 14px;display:flex;justify-content:space-between;align-items:center}
        .sc-title{font-size:13px;font-weight:700;color:var(--t0)}
        .sc-tag{font-size:10px;color:var(--t2);margin-top:1px}
        .sc-ctrl{display:flex;gap:5px;align-items:center;flex-wrap:wrap}
        .sc-body{padding:12px 14px}

        .kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}
        .kpi{background:var(--bg2);border-radius:5px;padding:8px 10px;border-left:2px solid var(--brd2)}
        .kpi-label{font-size:9px;color:var(--t2);text-transform:uppercase;letter-spacing:.7px;font-weight:700;margin-bottom:2px}
        .kpi-val{font-size:15px;font-weight:700;color:var(--t0)}
        .kpi.grn{border-left-color:var(--grn)}.kpi.grn .kpi-val{color:var(--grn)}
        .kpi.red{border-left-color:var(--red)}.kpi.red .kpi-val{color:var(--red)}
        .kpi.acc{border-left-color:var(--acc)}

        .bp-bar{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;padding:8px;background:var(--bg2);border-radius:5px;margin-bottom:10px;border:1px solid var(--brd)}
        .bp-cell{text-align:center;padding:3px 0;border-right:1px solid var(--brd)}.bp-cell:last-child{border:none}
        .bp-lbl{font-size:9px;color:var(--t2);text-transform:uppercase;font-weight:700}
        .bp-val{font-size:12px;font-weight:700;margin-top:1px}
        .bp-acc{color:var(--acc)}.bp-pur{color:var(--pur)}.bp-cyn{color:var(--acc2)}

        .sec-lbl{font-size:10px;color:var(--t2);text-transform:uppercase;font-weight:700;letter-spacing:1px;margin:10px 0 5px;display:flex;justify-content:space-between;align-items:center}
        .sec-cnt{background:var(--bg3);color:var(--t1);padding:1px 6px;border-radius:3px;font-size:9px}

        /* Tables */
        .pt{width:100%;font-size:12px;border-collapse:collapse}
        .pt thead th{background:var(--bg2);color:var(--t2);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;padding:7px 8px;border-bottom:1px solid var(--brd)}
        .pt td{padding:7px 8px;border-bottom:1px solid var(--brd)}
        .pt tr:last-child td{border:none}
        .pt tr:hover{background:var(--bg2)}
        .tk{color:var(--acc);font-weight:700}
        .n{font-family:'JetBrains Mono',monospace;color:var(--t0);font-weight:600}
        .n-acc{color:var(--acc)}.n-sub{color:var(--t2);font-size:11px}
        .pl-g{color:var(--grn);font-weight:700}.pl-r{color:var(--red);font-weight:700}

        /* Buttons */
        .bp{padding:3px 8px;border-radius:4px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;border:1px solid;cursor:pointer;transition:all .15s}
        .bp-pri{background:var(--acc);border-color:var(--acc);color:#fff}.bp-pri:hover{filter:brightness(1.1)}
        .bp-out{background:transparent;border-color:var(--brd2);color:var(--t1)}.bp-out:hover{border-color:var(--acc);color:var(--acc)}
        .bp-dng{background:transparent;border-color:var(--red);color:var(--red)}.bp-dng:hover{background:var(--red);color:#fff}
        .bp-wrn{background:transparent;border-color:var(--yel);color:var(--yel)}.bp-wrn:hover{background:var(--yel);color:var(--bg0)}
        .bp-inf{background:transparent;border-color:var(--acc2);color:var(--acc2)}.bp-inf:hover{background:var(--acc2);color:var(--bg0)}
        .bp-grn{background:transparent;border-color:var(--grn);color:var(--grn)}.bp-grn:hover{background:var(--grn);color:var(--bg0)}
        .bp-pur{background:transparent;border-color:var(--pur);color:var(--pur)}.bp-pur:hover{background:var(--pur);color:var(--bg0)}

        /* Radar */
        .radar{background:var(--bg1);border:1px solid var(--brd);border-radius:8px;overflow:hidden}
        .radar-hdr{background:var(--bg2);border-bottom:1px solid var(--brd);padding:10px 14px;display:flex;justify-content:space-between;align-items:center}
        .radar-scroll{max-height:500px;overflow-y:auto}
        .rr.trigger{background:rgba(34,201,147,.04);border-left:2px solid var(--grn)}
        .rr.approaching{background:rgba(255,186,60,.04);border-left:2px solid var(--yel)}
        .rr.watch{border-left:2px solid transparent}
        .rr.ignored{opacity:.35}

        /* Terminal */
        .term{background:var(--bg1);border:1px solid var(--brd);border-radius:8px;overflow:hidden}
        .term-hdr{background:var(--bg2);border-bottom:1px solid var(--brd);padding:10px 14px}
        .term-body{background:#050810;padding:12px;height:480px;overflow-y:auto;font-family:'JetBrains Mono',monospace;font-size:11px;line-height:1.5;color:var(--t1)}
        .term-time{color:var(--acc2);margin-right:6px}

        /* IBKR health panel */
        .ibkr-panel{background:var(--bg1);border:1px solid var(--brd);border-radius:8px;overflow:hidden;margin-bottom:14px}
        .ibkr-hdr{background:var(--bg2);border-bottom:1px solid var(--brd);padding:10px 14px;display:flex;justify-content:space-between;align-items:center}
        .ibkr-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:var(--brd)}
        .ibkr-cell{background:var(--bg1);padding:10px 14px}

        /* Modals */
        .modal-content{background:var(--bg1);border:1px solid var(--brd2);color:var(--t1);border-radius:8px}
        .modal-header,.modal-footer{border-color:var(--brd)}
        .modal-title{color:var(--t0);font-weight:700}
        .form-control{background:var(--bg3);border:1px solid var(--brd2);color:var(--t0);font-family:'JetBrains Mono',monospace}
        .form-control:focus{background:var(--bg3);color:var(--t0);border-color:var(--acc);box-shadow:none}
        .input-group-text{background:var(--bg2);border:1px solid var(--brd2);color:var(--t2)}
        .dropdown-menu{background:var(--bg1);border:1px solid var(--brd2)}
        .dropdown-item{color:var(--t1);font-size:12px;padding:6px 14px}.dropdown-item:hover{background:var(--bg3);color:var(--t0)}
        .dropdown-divider{border-color:var(--brd)}

        /* Spec sheet */
        .spec-tag{font-size:13px;color:var(--t1);font-style:italic;padding:12px;background:var(--bg2);border-left:3px solid var(--acc);border-radius:4px;margin-bottom:16px}
        .spec-h{font-size:10px;color:var(--t2);text-transform:uppercase;font-weight:800;letter-spacing:1px;margin:12px 0 6px}
        .spec-list{list-style:none;padding:0;margin:0}.spec-list li{padding:5px 0;border-bottom:1px solid var(--brd);font-size:12px}.spec-list li:last-child{border:none}.spec-list li::before{content:'▸ ';color:var(--acc);font-weight:700}
        .spec-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
        .spec-cell{background:var(--bg2);padding:8px 10px;border-radius:5px;border-left:2px solid var(--acc)}
        .spec-cell-lbl{font-size:9px;color:var(--t2);text-transform:uppercase;font-weight:700;letter-spacing:.7px;margin-bottom:3px}
        .spec-cell-val{font-size:12px;color:var(--t0);font-weight:500}
    </style>
</head>
<body>

<!-- TOP BAR -->
<div class="top-bar">
    <div class="brand">
        <div class="brand-logo">M</div>
        <div>
            <div class="brand-name">MIT-Loop Pro</div>
            <div class="brand-sub">Quant Terminal · v3.0</div>
        </div>
    </div>
    <div class="hdr-actions">
        <span class="mkt-badge {% if state.market_phase == 'open' %}mkt-open{% elif state.market_phase == 'premarket' or state.market_phase == 'afterhours' %}mkt-pre{% else %}mkt-closed{% endif %}">{{ state.market_status }}</span>
        <span id="mkt-timer" class="pill pill-gry mono">--:--:--</span>

        {% if state.vix.current %}
        <span class="pill {% if state.vix.level == 'LOW' %}pill-grn{% elif state.vix.level == 'ELEVATED' %}pill-yel{% elif state.vix.level == 'HIGH' %}pill-red{% else %}pill-red{% endif %}" title="VIX Proxy (VIXY)">VIX {{ state.vix.current }}</span>
        {% endif %}

        {% if state.s4_regime %}
        <span class="pill {% if state.s4_regime == 'TREND_UP' %}pill-grn{% elif state.s4_regime == 'TREND_DOWN' %}pill-red{% else %}pill-yel{% endif %}" title="TQQQ Regime">TQQQ: {{ state.s4_regime }}</span>
        {% endif %}

        <form action="/cancel-all-orders" method="POST" style="margin:0" onsubmit="return confirm('Cancel ALL pending orders?');">
            <button class="bp bp-wrn">Wipe Limits</button>
        </form>
        <button class="bp bp-dng" data-bs-toggle="modal" data-bs-target="#panicModal">Liquidate All</button>
        <form action="/scan" method="POST" style="margin:0"><button class="bp bp-pri">Force Scan</button></form>
    </div>
</div>

<!-- IBKR + DATA INFRASTRUCTURE PANEL -->
<div class="ibkr-panel">
    <div class="ibkr-hdr">
        <div>
            <span class="sc-title">Data Infrastructure</span>
            <span class="sc-tag" style="margin-left:8px">IB Gateway + IBKR Fetch Service</span>
        </div>
        <div>
            {% if state.ibkr_health.ib_connected %}
                <span class="pill pill-grn">IB Connected</span>
            {% elif state.ibkr_health.status == 'idle' %}
                <span class="pill pill-blu">IB Idle</span>
            {% elif state.ibkr_health.status %}
                <span class="pill pill-yel">{{ state.ibkr_health.status }}</span>
            {% else %}
                <span class="pill pill-gry">No Data</span>
            {% endif %}
        </div>
    </div>
    <div class="ibkr-grid">
        <div class="ibkr-cell">
            <div class="info-label">IB Gateway</div>
            <div class="info-val" style="font-size:13px;">{% if state.ibkr_health.ib_connected %}<span class="live-dot"></span>Connected{% elif state.ibkr_health.status %}Disconnected{% else %}Unknown{% endif %}</div>
            <div class="info-sub">Port 4001 · Auto-restart via IBC</div>
        </div>
        <div class="ibkr-cell">
            <div class="info-label">Fetch Status</div>
            <div class="info-val" style="font-size:13px;">{{ state.ibkr_health.status or 'Unknown' }}</div>
            {% if state.ibkr_health.sweep_progress %}
            <div class="info-sub">{{ state.ibkr_health.sweep_progress.ticker }} · {{ state.ibkr_health.sweep_progress.current }}/{{ state.ibkr_health.sweep_progress.total }}</div>
            {% endif %}
        </div>
        <div class="ibkr-cell">
            <div class="info-label">Tickers Tracked</div>
            <div class="info-val mono" style="font-size:13px;">{{ state.ibkr_ticker_count or '—' }}</div>
            <div class="info-sub">Daily/Weekly/Monthly/1H/4H/1min</div>
        </div>
        <div class="ibkr-cell">
            <div class="info-label">Last Main Sweep</div>
            <div class="info-val mono" style="font-size:12px;">{{ state.ibkr_health.last_main_sweep[:16] if state.ibkr_health.last_main_sweep else '—' }}</div>
            <div class="info-sub">{{ state.ibkr_health.main_sweep_duration_s or 0 }}s · {{ state.ibkr_health.errors_last_sweep or 0 }} errors</div>
        </div>
        <div class="ibkr-cell">
            <div class="info-label">Last 1-Min Sweep</div>
            <div class="info-val mono" style="font-size:12px;">{{ state.ibkr_health.get('last_1min_sweep', '—')[:16] if state.ibkr_health.get('last_1min_sweep') else '—' }}</div>
            <div class="info-sub">{{ state.ibkr_health.get('1min_sweep_duration_s', 0) }}s</div>
        </div>
        <div class="ibkr-cell">
            <div class="info-label">Total CSV Files</div>
            <div class="info-val mono" style="font-size:13px;">{{ state.ibkr_health.total_files or '—' }}</div>
            <div class="info-sub">Heartbeat: {{ state.ibkr_health.last_heartbeat[:19] if state.ibkr_health.last_heartbeat else '—' }}</div>
        </div>
    </div>
</div>

<div id="app-main">

<!-- STRATEGY CARDS -->
<div class="strat-grid">
{% for strat_name in state.strategy_order %}
{% if strat_name in state.accounts %}
{% set account = state.accounts[strat_name] %}
{% set spec = state.strategy_specs[strat_name] %}
{% set is_paused = state.paused_strategies.get(strat_name, False) %}
<div class="sc {% if is_paused %}paused{% endif %}">
    <div class="sc-hdr">
        <div>
            <div class="sc-title">
                {{ strat_name }}
                {% if is_paused %}<span class="pill pill-yel" style="margin-left:6px">PAUSED</span>{% endif %}
            </div>
            <div class="sc-tag">{{ spec.name }}</div>
        </div>
        <div class="sc-ctrl">
            <button class="bp bp-inf" data-bs-toggle="modal" data-bs-target="#spec-{{ strat_name }}">Spec</button>
            <form action="/pause-strategy/{{ strat_name }}" method="POST" style="margin:0">
                <button class="bp {% if is_paused %}bp-grn{% else %}bp-pur{% endif %}">{% if is_paused %}Resume{% else %}Pause{% endif %}</button>
            </form>
            <div class="dropdown">
                <button class="bp bp-dng dropdown-toggle" data-bs-toggle="dropdown">Flatten</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><form action="/liquidate-strategy/{{ strat_name }}" method="POST" style="margin:0" onsubmit="return confirm('Market-sell all {{ strat_name }}?');"><button class="dropdown-item" style="color:var(--red)">Sell All Now</button></form></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><form action="/schedule-liquidation/{{ strat_name }}/OPEN" method="POST" style="margin:0"><button class="dropdown-item">Schedule @ Open</button></form></li>
                    <li><form action="/schedule-liquidation/{{ strat_name }}/CLOSE" method="POST" style="margin:0"><button class="dropdown-item">Schedule @ Close</button></form></li>
                    {% if state.scheduled_liquidations[strat_name] %}
                    <li><hr class="dropdown-divider"></li>
                    <li><form action="/schedule-liquidation/{{ strat_name }}/OFF" method="POST" style="margin:0"><button class="dropdown-item" style="color:var(--yel)">Cancel Schedule</button></form></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
    <div class="sc-body">
        <div class="kpi-row">
            <div class="kpi acc"><div class="kpi-label">NAV</div><div class="kpi-val mono">${{ "{:,.0f}".format(account.equity) }}</div></div>
            <div class="kpi {% if account.total_unrealized_pnl >= 0 %}grn{% else %}red{% endif %}"><div class="kpi-label">Open P&L</div><div class="kpi-val mono">{% if account.total_unrealized_pnl >= 0 %}+{% endif %}${{ "{:,.0f}".format(account.total_unrealized_pnl) }}</div></div>
            <div class="kpi {% if account.day_pnl >= 0 %}grn{% else %}red{% endif %}"><div class="kpi-label">Day P&L</div><div class="kpi-val mono">{% if account.day_pnl >= 0 %}+{% endif %}${{ "{:,.0f}".format(account.day_pnl) }}</div></div>
        </div>
        <div class="bp-bar">
            <div class="bp-cell"><div class="bp-lbl">Buying Power</div><div class="bp-val bp-acc">${{ "{:,.0f}".format(account.buying_power) }}</div></div>
            <div class="bp-cell"><div class="bp-lbl">In Orders</div><div class="bp-val bp-pur">${{ "{:,.0f}".format(account.tied_up_cash) }}</div></div>
            <div class="bp-cell"><div class="bp-lbl">Cash</div><div class="bp-val bp-cyn">${{ "{:,.0f}".format(account.cash) }}</div></div>
        </div>

        <form action="/set-margin/{{ strat_name }}" method="POST" class="d-flex mb-2" style="gap:6px;align-items:center">
            <span class="kpi-label" style="white-space:nowrap">Margin:</span>
            <div class="input-group input-group-sm" style="flex:1">
                <span class="input-group-text">$</span>
                <input type="number" step="0.01" name="margin_amount" class="form-control" value="{{ account.margin_limit }}">
                <button class="bp bp-out">Set</button>
            </div>
        </form>

        <!-- WAITING -->
        <div class="sec-lbl"><span><span class="pill pill-yel">Waiting</span> Pending Entries</span><span class="sec-cnt">{{ account.pending_entries }}</span></div>
        <table class="pt"><thead><tr><th>Ticker</th><th>Qty</th><th>Limit</th><th class="text-end">Action</th></tr></thead><tbody>
        {% for order in account.pending_buys %}
        <tr>
            <td><span class="tk">{{ order.symbol }}</span></td>
            <td><span class="n">{{ order.qty|int }}</span></td>
            <td><span class="n n-acc">${{ "{:.2f}".format(order.limit_price) }}</span></td>
            <td class="text-end">
                <button class="bp bp-wrn" data-bs-toggle="modal" data-bs-target="#ee-{{ strat_name }}-{{ order.symbol }}">Edit</button>
                <form action="/market-sell-all/{{ strat_name }}/{{ order.symbol }}" method="POST" style="display:inline;margin:0" onsubmit="return confirm('Cancel {{ order.symbol }}?')"><button class="bp bp-dng">Kill</button></form>
            </td>
        </tr>
        <div class="modal fade" id="ee-{{ strat_name }}-{{ order.symbol }}" tabindex="-1"><div class="modal-dialog modal-sm"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Edit Entry · {{ order.symbol }}</h5><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <form action="/edit-entry/{{ strat_name }}/{{ order.symbol }}" method="POST">
                <div class="modal-body"><p style="font-size:11px;color:var(--t2)">Cancels old limit, recalculates ATR stop & sizing to 1% NAV.</p><label class="kpi-label">New Limit</label><input type="number" step="0.01" name="new_entry" class="form-control" value="{{ order.limit_price }}" required></div>
                <div class="modal-footer"><button class="bp bp-pri w-100">Recalculate & Route</button></div>
            </form>
        </div></div></div>
        {% else %}
        <tr><td colspan="4" style="text-align:center;color:var(--t2);font-style:italic;padding:12px">No pending entries{% if is_paused %} (strategy paused){% endif %}</td></tr>
        {% endfor %}
        </tbody></table>

        <!-- IN PLAY -->
        <div class="sec-lbl"><span><span class="pill pill-grn">In Play</span> Active Positions</span><span class="sec-cnt">{{ account.positions|length }}</span></div>
        <table class="pt"><thead><tr><th>Ticker · P&L</th><th>Entry · Live</th><th>SL · ATR</th><th class="text-end">Action</th></tr></thead><tbody>
        {% for pos in account.positions %}
        <tr>
            <td>
                <div><span class="tk">{{ pos.symbol }}</span> <span class="n-sub">{{ pos.qty }}sh · ${{ "{:,.0f}".format(pos.market_value) }}</span></div>
                <div style="margin-top:3px"><span class="{% if pos.unrealized_pl >= 0 %}pl-g{% else %}pl-r{% endif %} mono" style="font-size:11px">{% if pos.unrealized_pl >= 0 %}+{% endif %}${{ "{:.2f}".format(pos.unrealized_pl) }} ({{ "{:+.1f}".format(pos.unrealized_plpc) }}%)</span></div>
            </td>
            <td>
                <div class="n">${{ "{:.2f}".format(pos.avg_entry) }}</div>
                <div style="margin-top:3px"><span class="live-dot"></span><span class="n n-acc">${{ "{:.2f}".format(pos.current_price) }}</span></div>
            </td>
            <td>
                <div><span class="n-sub">SL:</span> <span class="n pl-r">${{ "{:.2f}".format(pos.sl_price) if pos.sl_price else "—" }}</span></div>
                <div style="margin-top:3px"><span class="n-sub">ATR:</span> <span class="n">${{ "{:.2f}".format(pos.current_atr) if pos.current_atr else "—" }}</span> <span class="n-sub">({{ "{:.1f}".format(pos.current_atr_pct) if pos.current_atr_pct else "0" }}%)</span></div>
            </td>
            <td class="text-end">
                <button class="bp bp-inf" style="margin-bottom:3px" data-bs-toggle="modal" data-bs-target="#sl-{{ strat_name }}-{{ pos.symbol }}">SL</button>
                <form action="/market-sell-all/{{ strat_name }}/{{ pos.symbol }}" method="POST" style="margin:0" onsubmit="return confirm('Market sell {{ pos.symbol }}?')"><button class="bp bp-dng">Exit</button></form>
            </td>
        </tr>
        <div class="modal fade" id="sl-{{ strat_name }}-{{ pos.symbol }}" tabindex="-1"><div class="modal-dialog modal-sm"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Edit Stop · {{ pos.symbol }}</h5><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <form action="/edit-sl/{{ strat_name }}/{{ pos.symbol }}" method="POST">
                <div class="modal-body">
                    <div style="font-size:12px;margin-bottom:10px">Entry: <span class="n">${{ "{:.2f}".format(pos.avg_entry) }}</span> · Current SL: <span class="n pl-r">${{ "{:.2f}".format(pos.sl_price) if pos.sl_price else "—" }}</span></div>
                    <label class="kpi-label">New Stop</label>
                    <input type="number" step="0.01" name="new_sl" id="sl{{ strat_name }}{{ pos.symbol }}" class="form-control" value="{{ pos.sl_price }}" required onkeyup="checkRisk(this,{{ pos.avg_entry }},{{ pos.qty }},{{ account.equity }})">
                    <div id="rw-sl{{ strat_name }}{{ pos.symbol }}" class="pl-r" style="font-size:11px;margin-top:6px;display:none"></div>
                </div>
                <div class="modal-footer"><button class="bp bp-pri w-100">Update Stop</button></div>
            </form>
        </div></div></div>
        {% else %}
        <tr><td colspan="4" style="text-align:center;color:var(--t2);font-style:italic;padding:12px">No active positions</td></tr>
        {% endfor %}
        </tbody></table>
    </div>
</div>

<!-- SPEC MODAL -->
<div class="modal fade" id="spec-{{ strat_name }}" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">{{ strat_name }} · Strategy Specification</h5><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <div class="spec-tag">{{ spec.tagline }}</div>
        <div class="spec-h">Timeframe</div><p style="font-size:13px;color:var(--t1)">{{ spec.timeframe }}</p>
        <div class="spec-h">Setup Rules</div>
        <ul class="spec-list">{% for rule in spec.rules %}<li>{{ rule }}</li>{% endfor %}</ul>
        <div class="spec-h" style="margin-top:16px">Execution</div>
        <div class="spec-grid">
            <div class="spec-cell"><div class="spec-cell-lbl">Entry</div><div class="spec-cell-val">{{ spec.entry }}</div></div>
            <div class="spec-cell"><div class="spec-cell-lbl">Stop-Loss</div><div class="spec-cell-val">{{ spec.stop }}</div></div>
            <div class="spec-cell"><div class="spec-cell-lbl">TP Leg 1</div><div class="spec-cell-val">{{ spec.tp_leg1 }}</div></div>
            <div class="spec-cell"><div class="spec-cell-lbl">Runner Exit</div><div class="spec-cell-val">{{ spec.exit_runner }}</div></div>
            <div class="spec-cell"><div class="spec-cell-lbl">Trailing</div><div class="spec-cell-val">{{ spec.trail }}</div></div>
            <div class="spec-cell"><div class="spec-cell-lbl">Risk</div><div class="spec-cell-val">{{ spec.risk }}</div></div>
        </div>
    </div>
</div></div></div>
{% endif %}
{% endfor %}
</div>

<!-- RADAR + TERMINAL -->
<div class="row g-3">
<div class="col-lg-8">
    <div class="radar">
        <div class="radar-hdr">
            <div><div class="sc-title">Strategic Pullback Radar</div><div class="sc-tag">Real-time distance to entry</div></div>
            <div style="display:flex;gap:5px">
                <span class="pill pill-grn">{{ state.pending_setups|selectattr('status','equalto','TRIGGER')|list|length }} Trigger</span>
                <span class="pill pill-yel">{{ state.pending_setups|selectattr('status','equalto','APPROACHING')|list|length }} Near</span>
                <span class="pill pill-gry">{{ state.pending_setups|selectattr('status','equalto','WATCH')|list|length }} Watch</span>
            </div>
        </div>
        <div class="radar-scroll">
            <table class="pt"><thead><tr><th>St</th><th>Strategy</th><th>Ticker</th><th>Live</th><th>Entry</th><th>TP1</th><th>ATR</th><th>Dist</th><th>Age</th><th class="text-end">Ctrl</th></tr></thead><tbody>
            {% for s in state.pending_setups %}
            <tr class="rr {{ s.status|lower }} {% if s.ignored %}ignored{% endif %}">
                <td>{% if s.status=='TRIGGER' %}<span class="pill pill-grn">TRG</span>{% elif s.status=='APPROACHING' %}<span class="pill pill-yel">NR</span>{% else %}<span class="pill pill-gry">W</span>{% endif %}</td>
                <td><span class="pill pill-blu">{{ s.strategy_key }}</span></td>
                <td><span class="tk">{{ s.symbol }}</span></td>
                <td><span class="live-dot"></span><span class="n">${{ "{:,.2f}".format(s.live_price) }}</span></td>
                <td><span class="n n-acc">${{ "{:,.2f}".format(s.target) }}</span></td>
                <td>{% if s.tp1 %}<span class="n pl-g">${{ "{:,.0f}".format(s.tp1) }}</span>{% else %}<span class="n-sub">—</span>{% endif %}</td>
                <td><span class="n">${{ "{:.2f}".format(s.atr) }}</span></td>
                <td><span class="{% if s.dist >= 0 %}pl-g{% else %}pl-r{% endif %} mono">{{ "{:+.1f}".format(s.dist) }}%</span></td>
                <td><span class="pill pill-gry">{{ s.age_label }}</span></td>
                <td class="text-end"><form action="/toggle-ignore/{{ s.symbol }}" method="POST" style="margin:0"><button class="bp {% if s.ignored %}bp-wrn{% else %}bp-out{% endif %}">{% if s.ignored %}On{% else %}Off{% endif %}</button></form></td>
            </tr>
            {% else %}
            <tr><td colspan="10" style="text-align:center;color:var(--t2);padding:28px">No setups. Click Force Scan.</td></tr>
            {% endfor %}
            </tbody></table>
        </div>
    </div>
</div>
<div class="col-lg-4">
    <div class="term">
        <div class="term-hdr"><div class="sc-title"><span class="live-dot"></span>Broker Log</div></div>
        <div class="term-body">{% for log in state.recent_actions %}<div><span class="term-time">[{{ log.time }}]</span>{{ log.message }}</div>{% endfor %}</div>
    </div>
</div>
</div>

</div><!-- /app-main -->

<!-- PANIC MODAL -->
<div class="modal fade" id="panicModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header" style="border-color:var(--red)"><h5 class="modal-title" style="color:var(--red)">DANGER · Global Liquidation</h5><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <p>Market-sell <b>EVERY POSITION</b> across <b>ALL STRATEGIES</b> and cancel every order.</p>
        <p style="text-align:center;margin:16px 0">Type <b style="background:var(--red);color:#fff;padding:2px 8px;border-radius:3px">LIQUIDATE</b></p>
        <input type="text" id="panicInput" class="form-control text-center" onkeyup="validatePanic()">
        <form action="/liquidate-all" method="POST" style="margin-top:14px"><button id="panicConfirmBtn" class="bp bp-dng w-100" disabled style="padding:10px">NUKE EVERYTHING</button></form>
    </div>
</div></div></div>

</body>
</html>
