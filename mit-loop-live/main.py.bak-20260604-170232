def log_system_action(message: str):
    system_state["recent_actions"].insert(0, {
        "time": datetime.datetime.now().strftime("%H:%M:%S"),
        "message": message,
    })
    if len(system_state["recent_actions"]) > 50:
        system_state["recent_actions"].pop()


def get_ignored_tickers():
    if os.path.exists(IGNORED_TICKERS_FILE):
        with open(IGNORED_TICKERS_FILE, "r") as f:
            return set(line.strip() for line in f if line.strip())
    return set()


def toggle_ignored_ticker(symbol):
    ignored = get_ignored_tickers()
    if symbol in ignored:
        ignored.remove(symbol)
        log_system_action(f"Override cleared: {symbol} enabled for execution.")
    else:
        ignored.add(symbol)
        log_system_action(f"Killswitch: {symbol} execution blocked.")
    with open(IGNORED_TICKERS_FILE, "w") as f:
        f.write("\n".join(sorted(ignored)))


def execute_liquidation(strat_name: str):
    try:
        client = clients[strat_name]
        client.close_all_positions(cancel_orders=True)
        log_system_action(f"[{strat_name}] FLATTEN EXECUTED.")
    except Exception as e:
        log_system_action(f"Failed to flatten {strat_name}: {str(e)}")


def check_market_hours():
    tz = zoneinfo.ZoneInfo("America/New_York")
    now = datetime.datetime.now(tz)
    if now.weekday() >= 5:
        system_state["market_status"] = "CLOSED (Weekend)"
        return
    market_open = now.replace(hour=9, minute=30, second=0, microsecond=0)
    market_close = now.replace(hour=16, minute=0, second=0, microsecond=0)
    system_state["market_status"] = "OPEN (Live Session)" if market_open <= now <= market_close else "CLOSED (Off-Hours)"


def calculate_wilders_atr(df, period=14):
    df = df.copy()
    df['prev_close'] = df['close'].shift(1)
    tr1 = df['high'] - df['low']
    tr2 = (df['high'] - df['prev_close']).abs()
    tr3 = (df['low'] - df['prev_close']).abs()
    df['true_range'] = pd.concat([tr1, tr2, tr3], axis=1).max(axis=1)
    return df['true_range'].ewm(alpha=1/period, adjust=False).mean()


def find_daily_pivot_lows(df_d, lookback=60):
    """Return list of recent daily pivot lows. Used to trail the Salmog3 runner."""
    if len(df_d) < lookback:
        return []
    recent = df_d.iloc[-lookback:].copy()
    recent['rolling_min_11'] = recent['low'].rolling(11).min()
    recent['is_pivot_low'] = recent['low'].shift(5) == recent['rolling_min_11']
    pivots = recent['low'].shift(5).where(recent['is_pivot_low']).dropna()
    return sorted(pivots.tolist())


