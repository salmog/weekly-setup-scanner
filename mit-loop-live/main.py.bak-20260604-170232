def find_next_pivot_above(df_w, body_level):
    """Find next weekly resistance pivot above body_level (for Salmog3 TP1)."""
    if 'is_pivot' not in df_w.columns:
        return None
    pivot_highs = df_w[df_w['is_pivot']]['high']
    above = pivot_highs[pivot_highs > body_level * 1.05]   # at least 5% above entry
    if not above.empty:
        return float(above.max())
    # Fallback: 6-month cycle high
    cycle_high = df_w['high'].iloc[-26:].max()
    if cycle_high > body_level * 1.05:
        return float(cycle_high)
    return None


def run_daily_scan():
    scan_start = time.time()
    system_state["scanner_status"] = "Scanning..."
    update_account_states()
    ignored_tickers = get_ignored_tickers()

    if not os.path.exists(HISTORICAL_DATA_DIR):
        system_state["scanner_status"] = "ERROR: Historical data dir missing."
        return

    all_files = [f for f in os.listdir(HISTORICAL_DATA_DIR) if f.endswith('_weekly.csv')]
    system_state["last_scan"] = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    system_state["scan_count_today"] = system_state.get("scan_count_today", 0) + 1

    prelim_setups = []

    for file in all_files:
        try:
            symbol = file.split('_')[0].upper()
            csv_d_path = os.path.join(HISTORICAL_DATA_DIR, f"{symbol}_daily.csv")
            if not os.path.exists(csv_d_path):
                continue

            df_d = pd.read_csv(csv_d_path)
            df_d.columns = df_d.columns.str.lower()
            for col in ['high', 'low', 'close']:
                df_d[col] = pd.to_numeric(df_d[col], errors='coerce')
            daily_atr = calculate_wilders_atr(df_d, 14).iloc[-1]
            if pd.isna(daily_atr) or daily_atr <= 0:
                continue

            df_w = pd.read_csv(os.path.join(HISTORICAL_DATA_DIR, file))
            df_w.columns = df_w.columns.str.lower()
            if len(df_w) < 60:
                continue

            for col in ['open', 'high', 'low', 'close', 'volume']:
                if col in df_w.columns:
                    df_w[col] = pd.to_numeric(df_w[col], errors='coerce').fillna(0)

            df_w['ema20'] = df_w['close'].ewm(span=20, adjust=False).mean()
            df_w['sma30'] = df_w['close'].rolling(30).mean()
            df_w['sma50'] = df_w['close'].rolling(50).mean()
            df_w['vol_avg'] = df_w['volume'].rolling(20).mean()
            df_w['rolling_max_11'] = df_w['high'].rolling(11).max()
            df_w['is_pivot'] = df_w['high'].shift(5) == df_w['rolling_max_11']
            df_w['body_max'] = df_w[['open', 'close']].max(axis=1)
            df_w['swing_body_res'] = np.where(df_w['is_pivot'], df_w['body_max'].shift(5), np.nan)
            df_w['swing_body_res'] = pd.Series(df_w['swing_body_res']).ffill()
            df_w['swing_wick_res'] = np.where(df_w['is_pivot'], df_w['high'].shift(5), np.nan)
            df_w['swing_wick_res'] = pd.Series(df_w['swing_wick_res']).ffill()

            recent_df = df_w.iloc[-60:].copy()
            if len(recent_df) < 20:
                continue
            current_row = recent_df.iloc[-1]

            # ============================================================
            # S2_WickScaled — wick retest breakout
            # ============================================================
            setup_active = False
            trigger_level, breakout_vol, weeks_above = 0.0, 0.0, 0
            for i in range(1, len(recent_df)):
                row = recent_df.iloc[i]
                prev_row = recent_df.iloc[i-1]
                current_res = row['swing_wick_res']
                if pd.isna(current_res):
                    continue

                if not setup_active:
                    is_liquid = row['close'] >= 5.0 and row['close'] * row['vol_avg'] >= 5_000_000
                    is_breakout = row['close'] > current_res and prev_row['close'] <= current_res
                    is_zigzag = row['close'] <= row['ema20'] * 1.25
                    is_high_vol = row['volume'] > row['vol_avg'] * 2.5
                    is_aligned = row['ema20'] > row['sma50']
                    is_sloping_up = i >= 4 and row['ema20'] > recent_df.iloc[i-4]['ema20']
                    if all([is_liquid, is_breakout, is_zigzag, is_high_vol, is_aligned, is_sloping_up]):
                        setup_active = True
                        trigger_level = current_res
                        breakout_vol = row['volume']
                        weeks_above = 0
                    continue

                if setup_active:
                    if row['close'] < row['sma50'] or weeks_above > 30:
                        setup_active = False
                        continue
                    weeks_above += 1
                    if i == len(recent_df) - 1 and weeks_above >= 4:
                        prelim_setups.append({
                            "symbol": symbol,
                            "strategy": "S2: Weekly Wick Retest",
                            "strategy_key": "S2_WickScaled",
                            "type": "WICK",
                            "target": float(trigger_level),
                            "tp1": None,
                            "age_label": f"{int(weeks_above)}W",
                            "csv_close": float(current_row['close']),
                            "csv_vol": float(current_row['volume']),
                            "breakout_vol": float(breakout_vol),
                            "atr": float(daily_atr),
                        })

            # ============================================================
            # S1_Salmog3_Weekly — weekly body retest with pivot TP
            # ============================================================
            setup_active = False
            trigger_level, breakout_vol, weeks_above = 0.0, 0.0, 0
            for i in range(1, len(recent_df)):
                row = recent_df.iloc[i]
                prev_row = recent_df.iloc[i-1]
                current_res = row['swing_body_res']
                if pd.isna(current_res):
                    continue

                if not setup_active:
                    is_liquid = row['close'] >= 5.0 and row['close'] * row['vol_avg'] >= 5_000_000
                    is_breakout = row['close'] > current_res and prev_row['close'] <= current_res
                    is_macro_bull = pd.notna(row['sma30']) and row['close'] > row['sma30']
                    is_zigzag = row['close'] <= row['ema20'] * 1.25
                    is_high_vol = row['volume'] > row['vol_avg'] * 2.5
                    is_aligned = row['ema20'] > row['sma50']
                    is_sloping_up = i >= 4 and row['ema20'] > recent_df.iloc[i-4]['ema20']
                    if all([is_liquid, is_breakout, is_macro_bull, is_zigzag, is_high_vol, is_aligned, is_sloping_up]):
                        setup_active = True
                        trigger_level = current_res
                        breakout_vol = row['volume']
                        weeks_above = 0
                    continue

                if setup_active:
                    # Invalidate on close below the breakout body level
                    if row['close'] < trigger_level * 0.95 or weeks_above > 30:
                        setup_active = False
                        continue
                    weeks_above += 1
                    if i == len(recent_df) - 1 and weeks_above >= 4:
                        # Pullback volume must be < breakout volume
                        if row['volume'] < breakout_vol:
                            tp1 = find_next_pivot_above(df_w, trigger_level)
                            prelim_setups.append({
                                "symbol": symbol,
                                "strategy": "Salmog3: Weekly Body Retest",
                                "strategy_key": "S1_Salmog3_Weekly",
                                "type": "SALMOG3",
                                "target": float(trigger_level),
                                "tp1": float(tp1) if tp1 else None,
                                "age_label": f"{int(weeks_above)}W",
                                "csv_close": float(current_row['close']),
                                "csv_vol": float(current_row['volume']),
                                "breakout_vol": float(breakout_vol),
                                "atr": float(daily_atr),
                            })

            # ============================================================
            # S1_BodyStrict — 1H V-Shape capitulation
            # ============================================================
            csv_1h_path = os.path.join(HISTORICAL_DATA_DIR, f"{symbol}_hourly.csv")
            if pd.notna(df_w['sma30'].iloc[-1]) and current_row['close'] >= df_w['sma30'].iloc[-1] * 0.85 and os.path.exists(csv_1h_path):
                cycle_high = df_w['high'].iloc[-26:].max()
                drawdown = (cycle_high - current_row['close']) / cycle_high
                if 0.15 <= drawdown <= 0.25:
                    df_1h = pd.read_csv(csv_1h_path)
                    df_1h.columns = df_1h.columns.str.lower()
                    if not df_1h.empty:
                        for c in ['open', 'high', 'low', 'close']:
                            df_1h[c] = pd.to_numeric(df_1h[c], errors='coerce').fillna(0)
                        row_1h = df_1h.iloc[-1]
                        tail_size_1h = (min(row_1h['open'], row_1h['close']) - row_1h['low']) / row_1h['close']
                        if tail_size_1h > 0.03:
                            prelim_setups.append({
                                "symbol": symbol,
                                "strategy": "S1: 1H V-Shape Capitulation",
                                "strategy_key": "S1_BodyStrict",
                                "type": "1H_TAIL",
                                "target": float(row_1h['low']),
                                "tp1": None,
                                "age_label": "1H",
                                "csv_close": float(row_1h['close']),
                                "csv_vol": 0.0,
                                "breakout_vol": 0.0,
                                "atr": float(daily_atr),
                            })

            # ============================================================
            # S3_4H_Hybrid — 4H breakout-retest dual-leg
            # ============================================================
            csv_4h_path = os.path.join(HISTORICAL_DATA_DIR, f"{symbol}_4h.csv")
            s3_target = float(current_row['swing_body_res'])
            if pd.notna(s3_target) and s3_target > 0 and os.path.exists(csv_4h_path):
                df_4h = pd.read_csv(csv_4h_path)
                df_4h.columns = df_4h.columns.str.lower()
                if len(df_4h) > 60:
                    for col in ['open', 'high', 'low', 'close', 'volume']:
                        df_4h[col] = pd.to_numeric(df_4h[col], errors='coerce').fillna(0)
                    df_4h['ema20'] = df_4h['close'].ewm(span=20, adjust=False).mean()
                    df_4h['ema50'] = df_4h['close'].ewm(span=50, adjust=False).mean()
                    df_4h['vol_avg'] = df_4h['volume'].rolling(20).mean()
                    recent_4h = df_4h.iloc[-60:].copy()
                    current_4h = recent_4h.iloc[-1]
                    if current_4h['ema20'] > current_4h['ema50']:
                        held_bars = 0
                        for val in reversed(recent_4h['close'].values):
                            if val > s3_target:
                                held_bars += 1
                            else:
                                break
                        if held_bars >= 4:
                            breakout_idx = len(recent_4h) - held_bars - 1
                            if breakout_idx >= 0:
                                breakout_bar = recent_4h.iloc[breakout_idx]
                                if breakout_bar['volume'] > breakout_bar['vol_avg'] * 1.2:
                                    dist = (current_4h['close'] - s3_target) / s3_target
                                    if 0 <= dist <= 0.05:
                                        prelim_setups.append({
                                            "symbol": symbol,
                                            "strategy": "S3: 4H PRO Model",
                                            "strategy_key": "S3_4H_Hybrid",
                                            "type": "BODY_4H",
                                            "target": float(s3_target),
                                            "tp1": None,
                                            "age_label": f"{held_bars} bars",
                                            "csv_close": float(current_4h['close']),
                                            "csv_vol": float(current_4h['volume']),
                                            "breakout_vol": float(breakout_bar['volume']),
                                            "atr": float(daily_atr),
                                        })
        except Exception:
            continue

    # ============================================================
    # Live price fetch + envelope routing
    # ============================================================
    symbols_to_fetch = list({s["symbol"] for s in prelim_setups})
    live_prices = {}
    if symbols_to_fetch:
        try:
            for i in range(0, len(symbols_to_fetch), 50):
                chunk = symbols_to_fetch[i:i+50]
                req = StockLatestTradeRequest(symbol_or_symbols=chunk)
                trades = data_client.get_stock_latest_trade(req)
                for sym, trade in trades.items():
                    live_prices[sym] = float(trade.price)
        except Exception:
            pass

    discovered_setups = []
    for setup in prelim_setups:
        sym = setup["symbol"]
        live_px = live_prices.get(sym, setup["csv_close"])
        trigger_level = setup["target"]
        distance_to_level = ((live_px - trigger_level) / trigger_level) * 100
        trigger_envelope = trigger_level * (1 + ENVELOPE_PCT)
        is_ignored = sym in ignored_tickers
        atr_pct = (setup["atr"] / trigger_level) * 100 if trigger_level > 0 and setup["atr"] > 0 else 0.0

        if live_px <= trigger_envelope:
            status = "TRIGGER"
            logic_desc = f"LIVE TRIGGER: Within {ENVELOPE_PCT*100:.1f}% envelope ({setup['age_label']})"
            if is_ignored:
                logic_desc = "BLOCKED: Manual override active"
            actionable = not is_ignored
        elif 0 < distance_to_level <= 5:
            status = "APPROACHING"
            logic_desc = f"APPROACHING: +{distance_to_level:.2f}% above target"
            actionable = False
        elif 5 < distance_to_level <= WATCHLIST_MAX_PCT:
            status = "WATCH"
            logic_desc = f"WATCHLIST: +{distance_to_level:.2f}% above target"
            actionable = False
        else:
            continue   # too far away to track

        discovered_setups.append({
            **setup,
            "live_price": live_px,
            "dist": distance_to_level,
            "status": status,
            "logic": logic_desc,
            "atr_pct": atr_pct,
            "actionable": actionable,
            "ignored": is_ignored,
        })

    discovered_setups.sort(key=lambda x: (x["status"] != "TRIGGER", abs(x["dist"])))
    system_state["pending_setups"] = discovered_setups

    # ============================================================
    # Route triggered setups to broker
    # ============================================================
    local_buying_power = {
        s: float(system_state["accounts"][s]["buying_power"]) if s in system_state["accounts"] else 0.0
        for s in clients
    }
    system_state["scanner_status"] = "Routing live triggers..."

    for setup in discovered_setups:
        if not setup.get("actionable") or setup.get("ignored"):
            continue

        for strat_name, client in clients.items():
            if setup["type"] != TARGET_MAP.get(strat_name):
                continue
            try:
                acct_data = system_state["accounts"].get(strat_name)
                if not acct_data:
                    continue

                risk_pct = 0.01
                usable_capital = min(acct_data["equity"] * 0.10, local_buying_power[strat_name])
                stop_loss_px = setup["target"] - (1.0 * setup["atr"])
                risk_per_share = setup["target"] - stop_loss_px

                if risk_per_share <= 0:
                    continue

                raw_shares = int(math.floor((acct_data["equity"] * risk_pct) / risk_per_share))
                shares = int(math.floor(usable_capital / setup["target"])) if (raw_shares * setup["target"]) > usable_capital else raw_shares
                total_cost = shares * setup["target"]

                if shares < 1 or total_cost > local_buying_power[strat_name]:
                    continue

                if strat_name == "S3_4H_Hybrid" and shares >= 2:
                    half = shares // 2
                    runner = shares - half
                    tp1_px = setup["target"] + (2.0 * risk_per_share)
                    client.submit_order(LimitOrderRequest(
                        symbol=setup["symbol"], qty=half, side=OrderSide.BUY, time_in_force=TimeInForce.GTC,
                        limit_price=round(setup["target"], 2), order_class=OrderClass.BRACKET,
                        take_profit=TakeProfitRequest(limit_price=round(tp1_px, 2)),
                        stop_loss=StopLossRequest(stop_price=round(stop_loss_px, 2)),
                    ))
                    client.submit_order(LimitOrderRequest(
                        symbol=setup["symbol"], qty=runner, side=OrderSide.BUY, time_in_force=TimeInForce.GTC,
                        limit_price=round(setup["target"], 2), order_class=OrderClass.OTO,
                        stop_loss=StopLossRequest(stop_price=round(stop_loss_px, 2)),
                    ))
                    log_system_action(f"[S3] DUAL-LEG: {shares}x {setup['symbol']} @ ${setup['target']:.2f}, TP +2R @ ${tp1_px:.2f}")

                elif strat_name == "S1_Salmog3_Weekly" and shares >= 2 and setup.get("tp1"):
                    half = shares // 2
                    runner = shares - half
                    tp1_px = setup["tp1"]
                    client.submit_order(LimitOrderRequest(
                        symbol=setup["symbol"], qty=half, side=OrderSide.BUY, time_in_force=TimeInForce.GTC,
                        limit_price=round(setup["target"], 2), order_class=OrderClass.BRACKET,
                        take_profit=TakeProfitRequest(limit_price=round(tp1_px, 2)),
                        stop_loss=StopLossRequest(stop_price=round(stop_loss_px, 2)),
                    ))
                    client.submit_order(LimitOrderRequest(
                        symbol=setup["symbol"], qty=runner, side=OrderSide.BUY, time_in_force=TimeInForce.GTC,
                        limit_price=round(setup["target"], 2), order_class=OrderClass.OTO,
                        stop_loss=StopLossRequest(stop_price=round(stop_loss_px, 2)),
                    ))
                    log_system_action(f"[Salmog3] DUAL-LEG: {shares}x {setup['symbol']} @ ${setup['target']:.2f}, TP @ ${tp1_px:.2f} (next pivot), runner trails daily pivots")

                else:
                    client.submit_order(LimitOrderRequest(
                        symbol=setup["symbol"], qty=shares, side=OrderSide.BUY, time_in_force=TimeInForce.GTC,
                        limit_price=round(setup["target"], 2), order_class=OrderClass.OTO,
                        stop_loss=StopLossRequest(stop_price=round(stop_loss_px, 2)),
                    ))
                    log_system_action(f"[{strat_name}] ENTRY: {shares}x {setup['symbol']} @ ${setup['target']:.2f}")

                local_buying_power[strat_name] -= total_cost
                setup["actionable"] = False

            except Exception as e:
                log_system_action(f"API REJECTION [{setup['symbol']}]: {str(e)[:80]}")
                setup["actionable"] = False

    system_state["scanner_status"] = "Monitoring active portfolios."
    system_state["last_scan_duration_s"] = round(time.time() - scan_start, 1)


